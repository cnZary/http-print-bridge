<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HttpPrintBridge</RootNamespace>
    <AssemblyName>HttpPrintBridge</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- No static web assets in this API-only service; keeps publish output clean. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <!-- Non-Debug only: trade longer AOT compile time for runtime output.
       Speed (default) = optimize-time codegen + vectorised sort: faster code, slightly
       larger exe. Pass -p:OptimizationPreference=Size for optimize-space codegen and
       dehydrated runtime data: smaller exe/footprint.
       IlcFoldIdenticalMethodBodies=true folds all identical bodies (the Release default
       folds generics only): a size win that costs extra link time.
       StackTraceSupport=false drops stack-trace metadata (smaller exe; exception stack
       traces lose method names, so diagnose with the debug build instead). -->
  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <OptimizationPreference>Speed</OptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <StackTraceSupport>false</StackTraceSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- pdfium.dll ships beside the exe; headers stay in native/ for reference only. -->
    <None Include="..\..\native\pdfium\bin\pdfium.dll" Link="pdfium.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not part of the runtime payload. -->
    <Content Remove="wwwroot\**" />
    <None Remove="wwwroot\**" />
  </ItemGroup>

</Project>
